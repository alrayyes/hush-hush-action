{
  "name": "hush-hush-action-tooling",
  "private": true,
  "description": "Not a JavaScript project. This exists so commitlint can resolve the shared config it extends, and so markdownlint and Prettier are pinned like everything else.",
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "markdownlint-cli2": "0.23.2",
    "lefthook": "2.1.10",
    "prettier": "3.9.6"
  },
  "trustedDependencies": ["lefthook"],
  "overrides": {
    "smol-toml": "1.8.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\""
  }
}
